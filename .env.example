# Copy this file to .env and fill in real values. Never commit .env (it's gitignored).
#
# Only needed by the one tool that places real orders and reads account balances:
# trading/live_bot.py. The simulator (trading/simulator.py) and the training pipeline
# (ml/trainer.py) use Binance's public market-data endpoints and need no credentials.

# Binance API credentials — trading/live_bot.py
API_KEY=
API_SECRET=

# Trading pair — trading/live_bot.py
ASSET=AMP
CURRENCY=USDT
CANDLES_TIME=15m

# Strategy parameters — trading/live_bot.py
SMA_WINDOW=5
ATR_WINDOW=5
ATR_MULTIPLIER=1.6
RSI_WINDOW=12
RSI_BUY_LIMIT=25
RSI_SELL_LIMIT=75
NUM_CONDITIONS=1
