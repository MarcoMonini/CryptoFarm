# Copy this file to .env and fill in real values. Never commit .env (it's gitignored).
#
# Only needed for the tools that place real orders / read account balances:
# dashboard_live.py, live_bot.py, live_bot_dual.py.
# The backtesting tools (simulator.py, grid_search.py) use Binance's public
# market-data endpoints and don't need real credentials.

# Binance API credentials (single account) — dashboard_live.py, live_bot.py
API_KEY=
API_SECRET=

# Binance API credentials (dual account) — live_bot_dual.py only
API_KEY1=
API_SECRET1=
API_KEY2=
API_SECRET2=

# Trading pair — live_bot.py / live_bot_dual.py
ASSET=AMP
CURRENCY=USDT
CANDLES_TIME=15m

# Strategy parameters — live_bot.py / live_bot_dual.py
SMA_WINDOW=5
ATR_WINDOW=5
ATR_MULTIPLIER=1.6
RSI_WINDOW=12
RSI_BUY_LIMIT=25
RSI_SELL_LIMIT=75
NUM_CONDITIONS=1
